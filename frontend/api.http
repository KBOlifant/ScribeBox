### ScribeBox API, for the VS Code "REST Client" extension (humao.rest-client).
### Click "Send Request" above any request. Run them top to bottom the first time.
###
### Values in {{$dotenv ...}} come from frontend/.env, so no secrets live in this file.
### Add a Firebase test account there:
###   TEST_USER_EMAIL=you+test@example.com
###   TEST_USER_PASSWORD=a-long-test-password

@baseUrl = http://localhost:3000
@firebaseKey = {{$dotenv NEXT_PUBLIC_FIREBASE_API_KEY}}
@token = {{login.response.body.idToken}}
@meetingId = {{createMeeting.response.body.meeting.id}}
@summaryId = {{createSummary.response.body.summary.id}}
@decisionId = {{createDecision.response.body.decision.id}}
@actionItemId = {{createActionItem.response.body.actionItem.id}}


############################## AUTH ##############################

### 0. (Once only) Create the test account in Firebase. Skip if it already exists.
POST https://identitytoolkit.googleapis.com/v1/accounts:signUp?key={{firebaseKey}}
Content-Type: application/json

{
  "email": "{{$dotenv TEST_USER_EMAIL}}",
  "password": "{{$dotenv TEST_USER_PASSWORD}}",
  "returnSecureToken": true
}

### 1. Sign in with Firebase. Every request below reuses the idToken from this response (valid 1 hour).
# @name login
POST https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebaseKey}}
Content-Type: application/json

{
  "email": "{{$dotenv TEST_USER_EMAIL}}",
  "password": "{{$dotenv TEST_USER_PASSWORD}}",
  "returnSecureToken": true
}

### 2. Who am I? Creates the user's database row on first call. Expect 200.
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{token}}

### 3. No token. Expect 401.
GET {{baseUrl}}/api/auth/me


############################## USERS ##############################

### 4. Get my account. Expect 200.
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{token}}

### 5. Change my name. Expect 200.
PATCH {{baseUrl}}/api/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Test User"
}

### 6. Try to change the email. It comes from Firebase. Expect 422.
PATCH {{baseUrl}}/api/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "other@example.com"
}


############################## MEETINGS ##############################

### 7. Create a meeting. Expect 201.
# @name createMeeting
POST {{baseUrl}}/api/meetings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Weekly product sync",
  "date": "2026-11-24",
  "sourceName": "weekly-sync.txt",
  "transcript": "[00:00] Ana: Morning all.\n[00:12] Ben: I'll send the pricing deck by Friday.\n[00:40] Ana: Great, let's ship the beta next week."
}

### 8. Create with bad input. Expect 422 with a message per field.
POST {{baseUrl}}/api/meetings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "",
  "date": "2026-02-30",
  "transcript": "   "
}

### 9. List my meetings (no transcripts). Expect 200.
GET {{baseUrl}}/api/meetings
Authorization: Bearer {{token}}

### 10. Get the meeting from step 7, with its transcript. Expect 200.
GET {{baseUrl}}/api/meetings/{{meetingId}}
Authorization: Bearer {{token}}

### 11. Rename it. Expect 200.
PATCH {{baseUrl}}/api/meetings/{{meetingId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Weekly product sync (renamed)"
}

### 12. Try to change the transcript. Expect 422.
PATCH {{baseUrl}}/api/meetings/{{meetingId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "transcript": "edited"
}


############################## ANALYSIS ##############################
### Runs before SUMMARIES: a fresh meeting has no run yet, so this works straight away.

### 13. Analyse the meeting now. Calls Jev and GPT, so it can take a minute. Expect 200 with a trace, stoppedBecause "done".
POST {{baseUrl}}/api/meetings/{{meetingId}}/analysis
Authorization: Bearer {{token}}

### 14. Run it again straight away. The newest run is done, so start a new run first (step 16). Expect 409.
POST {{baseUrl}}/api/meetings/{{meetingId}}/analysis
Authorization: Bearer {{token}}

### 15. Meeting id that is not a UUID. Expect 404.
POST {{baseUrl}}/api/meetings/not-a-uuid/analysis
Authorization: Bearer {{token}}


############################## SUMMARIES ##############################
### Analysis runs of the meeting from step 7. States: queued, working, done, failed, rate_limited, invalid.

### 16. Start a new run (the one from step 13 is done). The body is optional. Expect 201, state "queued".
# @name createSummary
POST {{baseUrl}}/api/meetings/{{meetingId}}/summaries
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "modelName": "test-model"
}

### 17. Start a second run while the first is still queued. Expect 409.
POST {{baseUrl}}/api/meetings/{{meetingId}}/summaries
Authorization: Bearer {{token}}

### 18. List the meeting's runs, newest first. Expect 200.
GET {{baseUrl}}/api/meetings/{{meetingId}}/summaries
Authorization: Bearer {{token}}

### 19. Get the run from step 16. Expect 200.
GET {{baseUrl}}/api/summaries/{{summaryId}}
Authorization: Bearer {{token}}

### 20. Edit the summary text and model name. Expect 200.
PATCH {{baseUrl}}/api/summaries/{{summaryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "summaryText": "Ben will send the pricing deck by Friday. The beta ships next week.",
  "modelName": "test-model-2"
}

### 21. Move queued to working. Expect 200.
PATCH {{baseUrl}}/api/summaries/{{summaryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "analysisState": "working"
}

### 22. Move back to queued. Use step 16 for a new run instead. Expect 409.
PATCH {{baseUrl}}/api/summaries/{{summaryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "analysisState": "queued"
}

### 23. Move working to done. Expect 200.
PATCH {{baseUrl}}/api/summaries/{{summaryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "analysisState": "done"
}

### 24. Id that is not a UUID. Expect 404.
GET {{baseUrl}}/api/summaries/not-a-uuid
Authorization: Bearer {{token}}

### 25. Delete the run. Expect 204.
DELETE {{baseUrl}}/api/summaries/{{summaryId}}
Authorization: Bearer {{token}}


############################## DECISIONS ##############################

### 26. Add a decision to the meeting. Expect 201.
# @name createDecision
POST {{baseUrl}}/api/meetings/{{meetingId}}/decisions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "decisionText": "Ship the beta next week."
}

### 27. Add with empty text. Expect 422.
POST {{baseUrl}}/api/meetings/{{meetingId}}/decisions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "decisionText": "   "
}

### 28. List the meeting's decisions. Expect 200.
GET {{baseUrl}}/api/meetings/{{meetingId}}/decisions
Authorization: Bearer {{token}}

### 29. Get the decision from step 26. Expect 200.
GET {{baseUrl}}/api/decisions/{{decisionId}}
Authorization: Bearer {{token}}

### 30. Reword it. Expect 200.
PATCH {{baseUrl}}/api/decisions/{{decisionId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "decisionText": "Ship the beta on Monday."
}

### 31. Empty PATCH body. Expect 400 "Send at least one field to update".
PATCH {{baseUrl}}/api/decisions/{{decisionId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### 32. Try to change the meeting. Expect 422 "This field can't be set here."
PATCH {{baseUrl}}/api/decisions/{{decisionId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "meetingId": "{{meetingId}}"
}

### 33. Delete the decision. Expect 204.
DELETE {{baseUrl}}/api/decisions/{{decisionId}}
Authorization: Bearer {{token}}

### 34. Get it again. Expect 404.
GET {{baseUrl}}/api/decisions/{{decisionId}}
Authorization: Bearer {{token}}


############################## ACTION ITEMS ##############################
### progressState is one of: todo, in_progress, done. Only title is required when creating.

### 35. Add an action item with every field. Expect 201.
# @name createActionItem
POST {{baseUrl}}/api/meetings/{{meetingId}}/action-items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Send the pricing deck",
  "owner": "Ben",
  "ownerNote": "Said so in the call",
  "actionDate": "2026-11-27",
  "dueNote": "by Friday",
  "transcriptQuote": "I'll send the pricing deck by Friday.",
  "cueTime": "00:12",
  "progressState": "todo"
}

### 36. Add one with only a title. Expect 201.
POST {{baseUrl}}/api/meetings/{{meetingId}}/action-items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Plan the beta launch"
}

### 37. Add with a missing title, a bad date and an unknown field. Expect 422 with a message per field.
POST {{baseUrl}}/api/meetings/{{meetingId}}/action-items
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "actionDate": "2026-02-30",
  "priority": "high"
}

### 38. List the meeting's action items. Expect 200.
GET {{baseUrl}}/api/meetings/{{meetingId}}/action-items
Authorization: Bearer {{token}}

### 39. List all my action items, across meetings. Expect 200.
GET {{baseUrl}}/api/action-items
Authorization: Bearer {{token}}

### 40. Only the ones still to do. Expect 200.
GET {{baseUrl}}/api/action-items?progressState=todo
Authorization: Bearer {{token}}

### 41. Bad filter value. Expect 400.
GET {{baseUrl}}/api/action-items?progressState=started
Authorization: Bearer {{token}}

### 42. Get the action item from step 35. Expect 200.
GET {{baseUrl}}/api/action-items/{{actionItemId}}
Authorization: Bearer {{token}}

### 43. Mark it in progress. Expect 200.
PATCH {{baseUrl}}/api/action-items/{{actionItemId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "progressState": "in_progress"
}

### 44. Clear the optional fields with null. Expect 200.
PATCH {{baseUrl}}/api/action-items/{{actionItemId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ownerNote": null,
  "actionDate": null,
  "dueNote": null
}

### 45. Id that is not a UUID. Expect 404.
GET {{baseUrl}}/api/action-items/not-a-uuid
Authorization: Bearer {{token}}

### 46. Delete the action item. Expect 204.
DELETE {{baseUrl}}/api/action-items/{{actionItemId}}
Authorization: Bearer {{token}}


############################## CLEAN UP ##############################
### Deleting the meeting also deletes its summaries, decisions and action items (step 36 included).

### 47. Delete the meeting. Expect 204.
DELETE {{baseUrl}}/api/meetings/{{meetingId}}
Authorization: Bearer {{token}}

### 48. Get it again. Expect 404.
GET {{baseUrl}}/api/meetings/{{meetingId}}
Authorization: Bearer {{token}}


############################## DELETE ACCOUNT ##############################

### 49. WARNING: deletes this account and ALL its meetings, summaries, decisions and action items.
### The Firebase login stays, so signing in again starts an empty account. Keep this last. Expect 204.
DELETE {{baseUrl}}/api/users/me
Authorization: Bearer {{token}}
