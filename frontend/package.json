{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "description": "ScribeBox: meeting transcripts into summaries, decisions and action items",
  "author": "KBOlifant",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "electron:dev": "electron . --dev",
    "electron:pack": "node scripts/electron-build.mjs --dir",
    "electron:build": "node scripts/electron-build.mjs"
  },
  "build": {
    "appId": "com.scribebox.desktop",
    "productName": "ScribeBox",
    "directories": { "output": "dist-electron" },
    "files": ["electron/**", "package.json"],
    "extraResources": [{ "from": ".next/standalone", "to": "app-server", "filter": ["**/*"] }],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "jose": "^6.2.18",
    "motion": "^12.43.0",
    "next": "16.4.6",
    "openai": "^7.64.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
